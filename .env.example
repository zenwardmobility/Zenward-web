# Copy to .env.local for local development. Do not commit real values.

# Absolute site URL used for SEO metadata (canonical URLs, Open Graph,
# sitemap). Production domain is not yet confirmed — see the Zenward
# Platform decision register ZD-027. Leave unset locally; it falls back to
# http://localhost:3000.
NEXT_PUBLIC_SITE_URL=

# Absolute URL of the Zenward operations platform (the app the "Sign In"
# header link points to). Its production URL is not confirmed yet — see
# Zenward Platform decision register ZD-027 / ZD-079. Leave unset and the
# header omits the Sign In link rather than guessing a domain.
NEXT_PUBLIC_APP_URL=

# Selects the request-intake adapter (src/lib/request-intake/adapter.ts).
# "stub" (default) accepts submissions and stores nothing. No other mode is
# implemented yet — see docs/architecture/request-intake-boundary.md for the
# replacement point once the Zenward Platform's trusted intake exists.
REQUEST_INTAKE_MODE=stub
