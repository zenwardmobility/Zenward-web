# Zenward-Web environment contract
# ---------------------------------
# Copy to .env.local for local development. NEVER commit real values.
#
# Two categories:
#   PUBLIC   (NEXT_PUBLIC_*) — inlined into the browser bundle. No secrets.
#   SERVER   — read only in Server Actions / route handlers. Never exposed
#              to the browser, never prefixed NEXT_PUBLIC_.
#
# This site holds NO Zenward Platform database credentials. Do not add
# NEXT_PUBLIC_SUPABASE_URL, SUPABASE_SECRET_KEY, DATABASE_URL, or similar —
# Web and Platform stay isolated (docs/architecture/request-intake-boundary.md).


# ============================================================
# PUBLIC VARIABLES  (safe in the browser bundle)
# ============================================================

# Canonical absolute site URL — drives SEO canonicals, Open Graph URLs, the
# social image URL, sitemap, and robots. Source of truth: changing this is
# all that's needed when a custom production domain is added.
# Production deployment: https://www.zenwardmobility.com
# Leave unset locally; falls back to http://localhost:3000.
NEXT_PUBLIC_SITE_URL=

# Reserved / currently UNUSED. The public site presents Zenward Mobility only
# as a transportation company and has no "Sign In" / operator / platform link
# in its navigation, so nothing reads this today. Left here as a placeholder
# in case a customer or operator entry point is added later; if you set it,
# also add the code that uses it — do not invent a destination.
NEXT_PUBLIC_APP_URL=


# ============================================================
# SERVER-ONLY VARIABLES  (never sent to the browser)
# ============================================================

# --- Transportation request intake -------------------------------------
# Selects the adapter in src/lib/request-intake/adapter.ts.
#   stub      (default; also used when unset or unrecognised) — the
#             UNLINKED state: no Nemryn integration is configured. Every
#             submission fails closed with a customer-safe "online requests
#             are unavailable, please call us" message; the form keeps what
#             the visitor typed. Delivers NOTHING, stores nothing, logs no
#             content, and never shows "Request received".
#   platform  — server-to-server POST of a flat JSON body to the Nemryn
#             public intake endpoint (full contract: docs/architecture/nemryn-
#             trusted-request-intake-contract.md). Selecting this mode
#             without the two vars below fails closed with a "call us"
#             message (it never fakes success). `delivered:true` is
#             returned only on Nemryn's own positive `200 {"ok":true}`
#             acceptance.
REQUEST_INTAKE_MODE=stub

# Only used when REQUEST_INTAKE_MODE=platform. Server-only; never
# NEXT_PUBLIC_, never logged, never returned to the browser. URL must be
# https://.
#   PLATFORM_INTAKE_URL             — https://app.nemryn.com/api/public-intake/website
#   PLATFORM_INTAKE_INTEGRATION_ID  — the opaque per-integration identifier
#     Nemryn issued for this website (NOT a bearer token, NOT a privileged
#     credential, NOT Nemryn's own Supabase service-role key — it only
#     identifies which configured Nemryn integration a submission belongs
#     to; Nemryn's own database resolves everything else). Do not guess or
#     invent this value — copy it from Nemryn → Website Requests →
#     "Connect my existing form" for this website.
PLATFORM_INTAKE_URL=
PLATFORM_INTAKE_INTEGRATION_ID=

# OPTIONAL, server-only. The `Origin` header sent on the server-to-server POST.
# Nemryn's integration for this website is origin-locked and fails closed
# without an Origin (a server-side fetch sends none). Defaults to
# https://www.zenwardmobility.com — leave UNSET unless the approved website
# URL entered in Nemryn is a different origin.
PLATFORM_INTAKE_ORIGIN=

# --- Contact / "Talk to Our Team" intake -------------------------------
# Selects the adapter in src/lib/contact-intake/adapter.ts.
#   stub   (repo default) — acknowledges the enquiry, delivers nothing. The
#          success screen truthfully says the message was NOT sent and asks
#          the visitor to call.
#   email  (INTENDED PRODUCTION VALUE) — sends a plain-text internal enquiry
#          via Resend (https://resend.com) using the three vars below. The
#          contact form collects no passenger medical detail, so ordinary
#          email is acceptable here (unlike transportation requests). The
#          success screen confirms delivery ONLY after a 2xx from Resend;
#          any misconfiguration or provider failure fails closed with the
#          "call us" screen and never claims delivery.
# For production set CONTACT_INTAKE_MODE=email and all three vars below.
CONTACT_INTAKE_MODE=stub

# Only used when CONTACT_INTAKE_MODE=email. Owner-supplied — do not invent.
CONTACT_INTAKE_EMAIL=          # monitored, access-controlled inbox that receives enquiries
CONTACT_EMAIL_FROM=            # verified Resend sender, e.g. "Zenward Website <noreply@mail.zenwardmobility.com>"
CONTACT_EMAIL_API_KEY=         # Resend API key (re_...)

# --- Google Ads conversion measurement (ZW-WEB-04M) — DISABLED ----------
# READY BUT DISABLED. Server-only (never NEXT_PUBLIC_): the recommended
# architecture uploads click conversions from the server and loads NO Google
# script in the browser. See src/lib/analytics/google-ads.ts and
# docs/product/google-ads-conversion-activation-checklist.md.
#
# These variables CANNOT activate anything on their own: the code-level gate
# MEASUREMENT_APPROVED in google-ads.ts is false, and click-ID capture plus
# the server upload transport/credentials are not implemented. Activation is
# a reviewed change, released together with the Privacy-policy update.
# Leave all of these unset. Never invent IDs.
GOOGLE_ADS_CONVERSIONS_ENABLED=false
GOOGLE_ADS_CUSTOMER_ID=                     # owner-supplied, digits (dashes allowed)
GOOGLE_ADS_QUOTE_CONVERSION_ACTION_ID=      # "Transportation Quote Submitted" (PRIMARY)
GOOGLE_ADS_PROVIDER_CONVERSION_ACTION_ID=   # "Provider Enquiry" (SECONDARY)
# Phone clicks are not uploaded: measure real calls with Google call reporting.
