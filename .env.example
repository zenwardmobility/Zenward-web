# Zenward-Web environment contract
# ---------------------------------
# Copy to .env.local for local development. NEVER commit real values.
#
# Two categories:
#   PUBLIC   (NEXT_PUBLIC_*) — inlined into the browser bundle. No secrets.
#   SERVER   — read only in Server Actions / route handlers. Never exposed
#              to the browser, never prefixed NEXT_PUBLIC_.
#
# This site holds NO Zenward Platform database credentials. Do not add
# NEXT_PUBLIC_SUPABASE_URL, SUPABASE_SECRET_KEY, DATABASE_URL, or similar —
# Web and Platform stay isolated (docs/architecture/request-intake-boundary.md).


# ============================================================
# PUBLIC VARIABLES  (safe in the browser bundle)
# ============================================================

# Canonical absolute site URL — drives SEO canonicals, Open Graph URLs, the
# social image URL, sitemap, and robots. Source of truth: changing this is
# all that's needed when a custom production domain is added.
# Current deployment: https://zenward-web.vercel.app
# Leave unset locally; falls back to http://localhost:3000.
NEXT_PUBLIC_SITE_URL=

# Absolute URL of the Zenward operations platform, for the header "Sign In"
# link. No valid Platform URL exists yet (Zenward Platform ZD-027 / ZD-079),
# so leave this unset — the header hides "Sign In" rather than linking to a
# placeholder. Do not invent a destination.
NEXT_PUBLIC_APP_URL=


# ============================================================
# SERVER-ONLY VARIABLES  (never sent to the browser)
# ============================================================

# --- Transportation request intake -------------------------------------
# Selects the adapter in src/lib/request-intake/adapter.ts.
#   stub      (default) — validates and acknowledges the form, delivers
#             NOTHING, stores nothing, logs no content. The success screen
#             tells the visitor to also call to confirm.
#   platform  — signed server-to-server POST to the Zenward Platform's
#             trusted TransportationRequest intake. That endpoint does not
#             exist yet; selecting this mode without the two vars below
#             fails closed with a "call us" message (it never fakes success).
REQUEST_INTAKE_MODE=stub

# Only used when REQUEST_INTAKE_MODE=platform. Do not guess these.
PLATFORM_INTAKE_URL=
PLATFORM_INTAKE_TOKEN=

# --- Contact / "Talk to Our Team" intake -------------------------------
# Selects the adapter in src/lib/contact-intake/adapter.ts.
#   stub   (default) — acknowledges the enquiry, delivers nothing.
#   email  — sends a plain-text internal enquiry via Resend
#            (https://resend.com) using the three vars below. The contact
#            form collects no passenger medical detail, so ordinary email
#            is acceptable here (unlike transportation requests).
CONTACT_INTAKE_MODE=stub

# Only used when CONTACT_INTAKE_MODE=email.
CONTACT_INTAKE_EMAIL=          # internal inbox that receives enquiries
CONTACT_EMAIL_FROM=            # verified Resend sender, e.g. "Zenward Website <noreply@your-domain>"
CONTACT_EMAIL_API_KEY=         # Resend API key (re_...)
